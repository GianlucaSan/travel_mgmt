<odoo>
    <record id="view_travel_mgmt_list" model="ir.ui.view">
        <field name="name">travel.mgmt.tree</field>
        <field name="model">travel.mgmt</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_travel_mgmt_form" model="ir.ui.view">
        <field name="name">travel.mgmt.form</field>
        <field name="model">travel.mgmt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_create_expenses" type="object" string="Crea Spese" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="employee_id"/>
                        <field name="company_id"/>
                        <field name="paid_by"/>
                    </group>

                    <notebook>
                        <page string="Righe Spese">
                            <field name="expense_lines">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Note">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_travel_mgmt" model="ir.actions.act_window">
        <field name="name">Travel Management</field>
        <field name="res_model">travel.mgmt</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_travel_root" name="Travel Management" sequence="10"/>
    <menuitem id="menu_travel_mgmt" name="Viaggi" parent="menu_travel_root" action="action_travel_mgmt"/>
</odoo>
